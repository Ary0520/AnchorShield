# AnchorShield Watcher — environment configuration
# Copy this file to .env and fill in the values after deployment.
# NEVER commit .env to git.

# ── Network ──────────────────────────────────────────────────────────────────
# Testnet (default):
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
#
# Mainnet (swap these in when going live):
# STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
# HORIZON_URL=https://horizon.stellar.org
# NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ── Watcher keypair ───────────────────────────────────────────────────────────
# A funded Stellar account used to submit settlement + fill_orders transactions.
# Must hold enough XLM to cover transaction fees (~0.01 XLM per tx).
# Generate with: stellar keys generate watcher --network testnet
# Fund with:     stellar keys fund watcher --network testnet
# IMPORTANT: Use a dedicated keypair, NOT your deployer or personal key.
WATCHER_SECRET_KEY=S...

# ── Deployed contract addresses ──────────────────────────────────────────────
# Populated after running scripts/deploy-testnet.sh
MARKET_FACTORY_CONTRACT=C...
ANCHOR_STAKE_CONTRACT=C...

# ── Oracle contract ───────────────────────────────────────────────────────────
# Reflector Network — SEP-40 push oracle (price stored on-chain, updated every 5 min)
# Source: https://developers.stellar.org/docs/data/oracles/oracle-providers
#         https://reflector.network/docs
#
# WHY REFLECTOR: RedStone's Stellar integration uses a pull model requiring their
# stellar-connector package. Our contracts use SEP-40 push (lastprice() call).
# Reflector is SEP-40 compatible and already integrated with DeFindex.
#
# Testnet  — "External CEXs & DEXs" feed:
ORACLE_CONTRACT=CCYOZJCOPG34LLQQ7N24YXBM7LL62R7ONMZ3G6WZAAYPB5OYKOMJRN63
#
# Mainnet — "External CEXs & DEXs" feed (uncomment when deploying to mainnet):
# ORACLE_CONTRACT=CAFJZQWSED6YAWZU3GWRTOCNPPCGBN32L7QV43XX5LZLFTK6JLN34DLN
