# AnchorShield Watcher — environment configuration
# Copy this file to .env and fill in the values after deployment.
# NEVER commit .env to git.

# ── Network ──────────────────────────────────────────────────────────────────
# Testnet:
#   STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#   HORIZON_URL=https://horizon-testnet.stellar.org
#   NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Mainnet:
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
HORIZON_URL=https://horizon.stellar.org
NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# ── Watcher keypair ───────────────────────────────────────────────────────────
# A funded Stellar account used to submit settlement + fill_orders transactions.
# Must hold enough XLM to cover transaction fees (~0.01 XLM per tx).
# Generate with: stellar keys generate watcher --network testnet
WATCHER_SECRET_KEY=S...

# ── Deployed contract addresses ──────────────────────────────────────────────
# Populated after running scripts/deploy-testnet.sh or deploy-mainnet.sh
MARKET_FACTORY_CONTRACT=C...
ANCHOR_STAKE_CONTRACT=C...

# ── RedStone oracle ───────────────────────────────────────────────────────────
# Fetch from: https://docs.redstone.finance/docs/smart-contract-devs/get-started/stellar
REDSTONE_CONTRACT=C...
